# Copy to .env and fill in after deploying the AWS backend (aws/template.yaml).

# Base path for GitHub Pages (repo name). Leave '/' for local dev.
VITE_BASE_URL=/ffacademy-main/

# API Gateway base URL (SAM output: ApiUrl)
VITE_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com

# Cognito (SAM outputs: UserPoolId, UserPoolClientId, UserPoolRegion)
VITE_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_REGION=us-east-1

# Social sign-in (optional). Hosted-UI domain from SAM output CognitoDomain.
# Leave unset to hide the social buttons and use email/password only.
VITE_COGNITO_DOMAIN=ffacademy-auth.auth.us-east-1.amazoncognito.com
# Which buttons to show; each needs its identity provider deployed in Cognito.
VITE_OAUTH_PROVIDERS=Google,Microsoft,Yahoo
